# Copy this file to .env and fill in your values.
# Then load it with: export $(cat .env | xargs)
# Or install python-dotenv so main.py loads it automatically.

# Required: your OpenAI-compatible API key
MCTL_API_KEY=your_api_key_here

# Optional: override the API endpoint (default: OpenAI)
MCTL_API_URL=https://api.openai.com/v1/chat/completions

# Optional: model name (default: gpt-4o)
MCTL_API_MODEL=gpt-4o

# Optional: request timeout in seconds (default: 60)
MCTL_API_TIMEOUT=60

# Optional: root directory of the datasets (default: ./data)
MCTL_DATA_ROOT=./data
